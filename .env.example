# =============================================
# Vocali API - Environment Variables Example
# =============================================
# Copy this file to api/.env and fill in the values
# NEVER commit the real .env file to version control

# AWS Configuration
AWS_REGION=eu-west-1
STAGE=dev

# Dev auth: userId fijo para validateToken en modo mock (coincide con DynamoDB local)
# DEV_USER_ID=user-123

# DynamoDB
DYNAMODB_USERS_TABLE=vocali-users-dev
DYNAMODB_TRANSCRIPTIONS_TABLE=vocali-transcriptions-dev
DYNAMODB_JOB_MAPPING_TABLE=vocali-job-mapping-dev

# For local development with DynamoDB Local (docker-compose)
# DYNAMODB_ENDPOINT=http://localhost:8000

# S3
S3_BUCKET_NAME=vocali-transcriptions-dev

# AWS Cognito (prod: eu-north-1_b26FB6sIB / 1l72utd99e53tbo8mhcn0kr5qp)
COGNITO_USER_POOL_ID=eu-west-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Set to "true" in dev/staging to skip email verification
COGNITO_AUTO_CONFIRM=false

# Speechmatics (https://www.speechmatics.com)
SPEECHMATICS_API_KEY=your-speechmatics-api-key
# Public URL of your deployed webhook endpoint
# En prod: se construye automáticamente. En dev/local: usar ngrok o URL del API
SPEECHMATICS_WEBHOOK_URL=https://your-api-id.execute-api.eu-north-1.amazonaws.com/prod/webhook/speechmatics
# Speechmatics Management API (for realtime token creation) — default is fine
SPEECHMATICS_MANAGEMENT_URL=https://mp.speechmatics.com/v1
# Speechmatics Realtime WebSocket URL returned to the client — default is fine
SPEECHMATICS_RT_WS_URL=wss://eu2.rt.speechmatics.com/v2/
