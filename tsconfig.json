{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@domain/*": ["src/domain/*"],
      "@application/*": ["src/application/*"],
      "@infrastructure/*": ["src/infrastructure/*", "api/src/infrastructure/*"],
      "@presentation/*": ["src/presentation/*"],
      "@shared/*": ["src/shared/*"],
      "@domain/repositories/*": ["src/domain/repositories/*", "api/src/domain/repositories/*"],
      "@domain/entities/*": ["src/domain/entities/*", "api/src/domain/entities/*"],
      "jsonwebtoken": ["api/node_modules/@types/jsonwebtoken"],
      "jwks-rsa": ["api/node_modules/jwks-rsa"]
    }
  },
  "include": ["src/**/*", "api/src/**/*"],
  "exclude": ["node_modules", "api/dist", "tests"]
}
