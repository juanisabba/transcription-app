{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDirs": ["../src", "./src"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@domain/repositories/*": ["../src/domain/repositories/*", "./src/domain/repositories/*"],
      "@domain/entities/*": ["../src/domain/entities/*", "./src/domain/entities/*"],
      "@domain/*": ["../src/domain/*"],
      "@application/*": ["../src/application/*"],
      "@infrastructure/*": ["../src/infrastructure/*", "./src/infrastructure/*"],
      "@presentation/*": ["../src/presentation/*"],
      "@shared/*": ["../src/shared/*"],
      "aws-lambda": ["./node_modules/@types/aws-lambda"],
      "@aws-sdk/client-cognito-identity-provider": ["./node_modules/@aws-sdk/client-cognito-identity-provider"],
      "@aws-sdk/client-s3": ["./node_modules/@aws-sdk/client-s3"],
      "@aws-sdk/s3-request-presigner": ["./node_modules/@aws-sdk/s3-request-presigner"],
      "uuid": ["./node_modules/uuid"],
      "bcryptjs": ["./node_modules/bcryptjs"],
      "jwks-rsa": ["./node_modules/jwks-rsa"]
    }
  },
  "include": ["../src/**/*", "./src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "../tests"]
}
