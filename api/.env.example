# AWS (para DynamoDB Local en .env.local usa credenciales dummy)
AWS_REGION=eu-west-1

# DynamoDB
# IMPORTANTE: Si usas DynamoDB Local (podman/docker), descomenta DYNAMODB_ENDPOINT.
# Estándar de desarrollo: vocali-users-dev, vocali-transcriptions-dev
DYNAMODB_USERS_TABLE=vocali-users-dev
DYNAMODB_TRANSCRIPTIONS_TABLE=vocali-transcriptions-dev
# DYNAMODB_ENDPOINT=http://localhost:8000

# S3 (transcriptions bucket)
S3_BUCKET_NAME=vocali-transcriptions-dev

# Speechmatics (transcripción asincrónica)
# Crear API key en https://portal.speechmatics.com/settings/api-keys/
SPEECHMATICS_API_KEY=your-speechmatics-api-key
# URL del webhook (tras deploy: https://xxx.execute-api.REGION.amazonaws.com/webhook/speechmatics)
SPEECHMATICS_WEBHOOK_URL=

# Cognito (required for auth endpoints)
# Prod: eu-north-1_b26FB6sIB / 1l72utd99e53tbo8mhcn0kr5qp
COGNITO_USER_POOL_ID=eu-west-1_xxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# En desarrollo local: COGNITO_AUTO_CONFIRM=true para saltar verificación email
COGNITO_AUTO_CONFIRM=false

# Optional (local development)
# NODE_ENV=development
# STAGE=local
# LOG_LEVEL=debug
