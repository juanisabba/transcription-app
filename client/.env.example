# =============================================
# Vocali Client - Variables de entorno
# =============================================
# Copiar a .env.local para desarrollo local

# --- IMPORTANTE: Frontend local contra API de prod ---
# Si .env.local tiene NUXT_PUBLIC_API_URL=http://localhost:3001, el login
# iría a la API local y el token sería de dev. Para probar contra prod:
# 1. Usa la URL de prod (abajo) O renombra/elimina .env.local
# 2. Limpia LocalStorage (DevTools > Application > Local Storage > Clear)
# 3. Haz login de nuevo para obtener un token de producción válido

# Desarrollo local (API en localhost:3001)
NUXT_PUBLIC_API_URL=http://localhost:3001

# Producción (descomenta para probar frontend local contra API prod)
# NUXT_PUBLIC_API_URL=https://qucod37on2.execute-api.eu-north-1.amazonaws.com/prod

# Cognito (prod: eu-north-1_b26FB6sIB / 1l72utd99e53tbo8mhcn0kr5qp)
# NUXT_PUBLIC_COGNITO_USER_POOL_ID=eu-north-1_b26FB6sIB
# NUXT_PUBLIC_COGNITO_CLIENT_ID=1l72utd99e53tbo8mhcn0kr5qp
